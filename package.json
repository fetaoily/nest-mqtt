{
  "name": "@fetaoily/nest-mqtt",
  "version": "1.0.7",
  "description": "A MQTT module for Nest.js",
  "author": "microud,fetaoily",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "url": "git+https://github.com/fetaoily/nest-mqtt.git"
  },
  "keywords": [
    "nest-mqtt",
    "nestjs-mqtt",
    "@nestjs/mqtt",
    "mqtt",
    "nestjs"
  ],
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "tslint -p tsconfig.json -c tslint.json",
    "login": "npm login --registry=https://registry.npmjs.org",
    "prepublishOnly": "npm run build",
    "release": "node scripts/publish.mjs"
  },
  "peerDependencies": {
    "@nestjs/common": "^6.10.11 || ^7.0.0 || ^8.0.0 || ^10.0.0 || ^11.0.0",
    "@nestjs/core": "^6.10.11 || ^7.0.0 || ^8.0.0 || ^10.0.0 || ^11.0.0",
    "mqtt": "^5.0.5"
  },
  "devDependencies": {
    "@nestjs/common": "11.2.3",
    "@nestjs/core": "11.2.3",
    "@types/node": "20.6.3",
    "mqtt": "5.15.2",
    "mqtt-packet": "9.0.2",
    "prettier": "3.0.3",
    "reflect-metadata": "0.1.13",
    "rimraf": "5.0.1",
    "rxjs": "7.8.1",
    "ts-node": "10.9.1",
    "tsc-watch": "6.0.4",
    "tsconfig-paths": "4.2.0",
    "tslint": "6.1.3",
    "typescript": "5.7.2"
  }
}
